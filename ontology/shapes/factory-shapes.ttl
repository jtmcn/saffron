# Every shape here states something §4.1 cannot: an enumeration over a TEXT
# column, a cardinality across a foreign key, or a disjointness between two
# columns that a row carries side by side.
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix factory: <urn:software-factory:ns#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix earl:    <http://www.w3.org/ns/earl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# A task ends in a state it can actually end in. `tasks.state` is TEXT and says
# neither which strings are legal nor which of them reach the operator (§3.3).
factory:TaskShape a sh:NodeShape ;
    sh:targetClass factory:Task ;
    sh:property [ sh:path factory:endedInState ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class factory:EndState ;
        sh:in ( factory:SCOPE_REVIEW factory:PLAN_REJECTED factory:EXHAUSTED
                factory:READY_FOR_REVIEW factory:MERGE_FAILED factory:PREFLIGHT_FAILED
                factory:NOT_IMPLEMENTED factory:GATE_ERROR factory:RATE_LIMITED
                factory:APPROVED factory:CHANGES_REQUESTED factory:REJECTED
                factory:MERGED factory:ORPHANED ) ] ;
    sh:property [ sh:path factory:riskTier ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class factory:RiskTier ; sh:in ( factory:standard factory:elevated ) ] .

# Nine states reach the operator and no others — set containment inside the end
# states, which is the distinction §4.6 names as justifying the namespace. What
# the operator's own decision produces is an end state and is not terminal: the
# conflation is how MERGED read as reaching the operator and ORPHANED, which
# `session.py` writes, read as illegal.
factory:TerminalStateShape a sh:NodeShape ;
    sh:targetClass factory:TerminalState ;
    sh:class factory:EndState ;
    sh:in ( factory:SCOPE_REVIEW factory:PLAN_REJECTED factory:EXHAUSTED
            factory:READY_FOR_REVIEW factory:MERGE_FAILED factory:PREFLIGHT_FAILED
            factory:NOT_IMPLEMENTED factory:GATE_ERROR factory:RATE_LIMITED ) .

factory:SpecShape a sh:NodeShape ;
    sh:targetClass factory:Spec ;
    sh:property [ sh:path factory:specType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class factory:SpecType ;
        sh:in ( factory:feature factory:bug factory:refactor ) ] ;
    sh:property [ sh:path factory:hasCriterion ; sh:minCount 1 ;
        sh:class factory:AcceptanceCriterion ] .

# "Attempt 3" without a phase is ambiguous — name both (CONTEXT.md §2). The
# ledger's `attempts` row carries phase and n as two nullable columns.
factory:AttemptShape a sh:NodeShape ;
    sh:targetClass factory:Attempt ;
    sh:property [ sh:path factory:withinPhase ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class factory:Phase ] ;
    sh:property [ sh:path factory:n ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path factory:costUsdEst ; sh:maxCount 1 ; sh:datatype xsd:decimal ] .

# A batch is not a run: budget is a batch property, base_sha is a run property.
# Rev 4 left them sharing a table, which is the defect these two shapes forbid.
#
# `endedBecause` has minCount 0 on purpose. `batches.status` is nullable and
# NULL means *still running* — the one state §6's morning queue must tell from a
# night that stopped, and the axiom a CHECK constraint cannot state, since it
# can only say which strings are legal and not that absence is meaningful.
factory:BatchShape a sh:NodeShape ;
    sh:targetClass factory:Batch ;
    sh:property [ sh:path factory:budgetUsd ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path factory:baseSha ; sh:maxCount 0 ] ;
    sh:property [ sh:path factory:endedBecause ; sh:minCount 0 ; sh:maxCount 1 ;
        sh:class factory:BatchStopReason ;
        sh:in ( factory:DRAINED factory:BUDGET factory:UNTIL
            factory:INFRASTRUCTURE factory:INCOMPLETE ) ] .

factory:RunShape a sh:NodeShape ;
    sh:targetClass factory:Run ;
    sh:property [ sh:path factory:baseSha ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ] ;
    sh:property [ sh:path factory:budgetUsd ; sh:maxCount 0 ] .

# The core/repo boundary as an axiom: a gate is core, contract, or repo-defined,
# and never two of them.
factory:GateShape a sh:NodeShape ;
    sh:targetClass factory:Gate ;
    sh:xone ( [ sh:class factory:CoreGate ]
              [ sh:class factory:ContractGate ]
              [ sh:class factory:RepoDefinedGate ] ) ;
    sh:property [ sh:path factory:blockingAt ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class factory:BlockingLevel ;
        sh:in ( factory:alwaysBlocking factory:blockingWhenElevated factory:advisory ) ] .

# Closed sets stated in CONTEXT.md §4, where the ledger has one TEXT column.
# Repo-defined gate names are deliberately absent: §4 says they are not
# vocabulary, so the ontology must not close a set over them.
factory:CoreGateShape a sh:NodeShape ;
    sh:targetClass factory:CoreGate ;
    sh:in ( factory:scope factory:size factory:secrets
            factory:integrity factory:census factory:committed
            factory:criteria factory:revert factory:witness ) .

factory:GateRoleShape a sh:NodeShape ;
    sh:targetClass factory:GateRole ;
    sh:in ( factory:format factory:lint factory:types
            factory:tests factory:no-network factory:coverage ) .

# A contract gate is a repo's executable for one core-supplied role. This states
# the contract half only; nothing here forbids a role on a core gate, because
# `rdfs:domain` is an OWL axiom and no reasoner runs.
factory:ContractGateShape a sh:NodeShape ;
    sh:targetClass factory:ContractGate ;
    sh:property [ sh:path factory:role ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class factory:GateRole ] .

# Core gates' blocking levels are core-supplied: §5.4 fixes them, and `size` and
# `witness` are the two a tier moves. Stated as constraints rather than left
# as triples in the vocabulary — an unenforced fact in this ontology is what the
# dead-term test exists to delete, one level up. `sh:in` rather than
# `sh:hasValue` because `sh:targetNode` targets its node in every graph including
# the empty one, and only `sh:in` is vacuous when there are no values.
factory:CoreGateBlockingShape a sh:NodeShape ;
    sh:targetNode factory:scope, factory:secrets, factory:integrity,
                  factory:census, factory:committed, factory:criteria,
                  factory:revert ;
    sh:property [ sh:path factory:blockingAt ; sh:in ( factory:alwaysBlocking ) ] .

# The two core gates a risk tier moves, and the correction `SA-0001` forced on
# the design: §5.4 had `size` always-blocking and §5.6 had it becoming blocking
# at `elevated`, and both could not be true (Appendix B). `witness` takes the
# same two levels for the same reason (§5.4.1) — an elevated diff is where a
# claim guarded by nothing hurts most, and `contract.witness_blocking` is the
# function that says so. The shape's name is narrower than its target set; it is
# kept because renaming a shape is a `shacl` gate diff for a cosmetic gain.
factory:SizeTierShape a sh:NodeShape ;
    sh:targetNode factory:size, factory:witness ;
    sh:property [ sh:path factory:blockingAt ; sh:in ( factory:blockingWhenElevated ) ] .

# `coverage` is advisory at every tier — a design decision, not an oversight
# (§5.4). Stated over the role rather than one named gate, so it binds every
# repo's coverage executable and not just core's; no `policy.yaml` schema
# says this, and blocking on changed-line coverage is what `integrity` exists
# to prevent.
factory:CoverageShape a sh:NodeShape ;
    sh:targetClass factory:Gate ;
    sh:not [
        sh:property [ sh:path factory:role ; sh:hasValue factory:coverage ; sh:minCount 1 ] ;
        sh:property [ sh:path factory:blockingAt ; sh:minCount 1 ;
            sh:in ( factory:alwaysBlocking factory:blockingWhenElevated ) ] ] .

factory:PolicyShape a sh:NodeShape ;
    sh:targetClass factory:Policy ;
    sh:property [ sh:path factory:declaresGate ; sh:minCount 1 ; sh:class factory:Gate ] .

# Lens disjointness (§5.5): one finding, one lens. It is why any single blocker
# routes to REBUT and why there is no vote.
factory:FindingShape a sh:NodeShape ;
    sh:targetClass factory:Finding ;
    sh:property [ sh:path factory:severity ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class factory:Severity ;
        sh:in ( factory:blocker factory:concern factory:note ) ] ;
    sh:property [ sh:path earl:assertedBy ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class factory:CriticLens ] ;
    sh:property [ sh:path earl:subject ; sh:minCount 1 ; sh:class earl:TestSubject ] ;
    sh:property [ sh:path earl:mode ; sh:minCount 1 ; sh:maxCount 1 ] .

# A gate result is asserted by a gate, automatically. The mode is the only real
# difference between a gate result and a finding (§4.6), so it is stated rather
# than left to the table a row happens to sit in.
factory:GateResultShape a sh:NodeShape ;
    sh:targetClass factory:GateResult ;
    sh:property [ sh:path earl:assertedBy ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class factory:Gate ] ;
    sh:property [ sh:path earl:subject ; sh:minCount 1 ; sh:class earl:TestSubject ] ;
    sh:property [ sh:path earl:mode ; sh:minCount 1 ; sh:hasValue earl:automatic ] .

# Three judgements, three agents, one claim (§5.6). A rebuttal that records the
# implementer's position without the critic's is half of the disagreement.
factory:RebuttalShape a sh:NodeShape ;
    sh:targetClass factory:Rebuttal ;
    sh:property [ sh:path prov:used ; sh:minCount 1 ; sh:class factory:Finding ] ;
    sh:property [ sh:path ( prov:qualifiedAssociation prov:hadRole ) ;
        sh:class factory:Role ] ;
    sh:property [ sh:path prov:qualifiedAssociation ;
        sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ;
        sh:qualifiedValueShape [
            sh:property [ sh:path prov:hadRole ;
                sh:in ( factory:disputes factory:concedes ) ; sh:minCount 1 ] ;
            sh:property [ sh:path prov:agent ; sh:class factory:ImplementerSession ] ] ] ;
    sh:property [ sh:path prov:qualifiedAssociation ;
        sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ;
        sh:qualifiedValueShape [
            sh:property [ sh:path prov:hadRole ;
                sh:in ( factory:confirms factory:withdraws ) ; sh:minCount 1 ] ;
            sh:property [ sh:path prov:agent ; sh:class factory:CriticLens ] ] ] .

# Touches is ratified by the operator before it binds (§3). The proposal is not
# the ratified set, and only the ratified set feeds the `scope` gate.
factory:TouchesShape a sh:NodeShape ;
    sh:targetClass factory:TouchesSet ;
    sh:property [ sh:path factory:ratifiedBy ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class factory:Operator ] .

# A delegate acts only for the operator or another delegate, and each reaches the
# operator, so every chain ends there (a subagent acts for the delegate that
# started it). Never the operator, and never the agent of an attempt: a task's work
# is done in a cell, where it is enforced. The ledger cannot tell a delegate from
# the operator, so no projection of it yields one — this binds fixtures, not data.
factory:DelegateShape a sh:NodeShape ;
    sh:targetClass factory:Delegate ;
    sh:not [ sh:class factory:Operator ] ;
    sh:property [ sh:path prov:actedOnBehalfOf ;
        sh:or ( [ sh:class factory:Operator ] [ sh:class factory:Delegate ] ) ] ;
    sh:property [ sh:path [ sh:oneOrMorePath prov:actedOnBehalfOf ] ;
        sh:qualifiedValueShape [ sh:class factory:Operator ] ;
        sh:qualifiedMinCount 1 ] ;
    # Both association forms, so the unqualified shortcut is no way around it.
    sh:property [
        sh:path [ sh:alternativePath (
            ( [ sh:inversePath prov:agent ] [ sh:inversePath prov:qualifiedAssociation ] )
            [ sh:inversePath prov:wasAssociatedWith ] ) ] ;
        sh:qualifiedValueShape [ sh:class factory:Attempt ] ;
        sh:qualifiedMaxCount 0 ] .

# The implementer acts for the operator, directly or through a delegate, and
# every attempt of its that wrote a diff carries the plan the host validated. A
# scope proposal or a rejected plan ends an attempt with no diff (§5.3, §5.3.1).
# ponytail: any factory:Plan satisfies it, not the task's own; tying them needs SPARQL.
factory:ImplementerSessionShape a sh:NodeShape ;
    sh:targetClass factory:ImplementerSession ;
    sh:property [ sh:path prov:actedOnBehalfOf ;
        sh:or ( [ sh:class factory:Operator ] [ sh:class factory:Delegate ] ) ] ;
    sh:property [ sh:path [ sh:oneOrMorePath prov:actedOnBehalfOf ] ;
        sh:qualifiedValueShape [ sh:class factory:Operator ] ;
        sh:qualifiedMinCount 1 ] ;
    # No association with such an attempt lacks a factory:Plan; any prov:Plan will not do.
    sh:property [ sh:path [ sh:inversePath prov:agent ] ;
        sh:qualifiedValueShape [ sh:and (
            [ sh:property [ sh:path [ sh:inversePath prov:qualifiedAssociation ] ;
                sh:qualifiedValueShape [ sh:class factory:Attempt ;
                    sh:property [ sh:path prov:generated ;
                        sh:qualifiedValueShape [ sh:class factory:Diff ] ;
                        sh:qualifiedMinCount 1 ] ] ;
                sh:qualifiedMinCount 1 ] ]
            [ sh:not [ sh:property [ sh:path prov:hadPlan ;
                sh:qualifiedValueShape [ sh:class factory:Plan ] ;
                sh:qualifiedMinCount 1 ] ] ] ) ] ;
        sh:qualifiedMaxCount 0 ] ;
    # The shortcut cannot carry a plan, so it stands only beside a qualified form
    # that does — which PROV-O's chain axiom entails it from.
    sh:property [ sh:path [ sh:inversePath prov:wasAssociatedWith ] ;
        sh:qualifiedValueShape [ sh:class factory:Attempt ;
            sh:property [ sh:path prov:generated ;
                sh:qualifiedValueShape [ sh:class factory:Diff ] ;
                sh:qualifiedMinCount 1 ] ;
            sh:not [ sh:property [ sh:path ( prov:qualifiedAssociation prov:hadPlan ) ;
                sh:qualifiedValueShape [ sh:class factory:Plan ] ;
                sh:qualifiedMinCount 1 ] ] ] ;
        sh:qualifiedMaxCount 0 ] .

# An envelope is a reading bound and is never enforced against a diff (§3). It
# may therefore never be a gate result's subject — the confusion the CONTEXT.md
# rule against bare "scope" exists to prevent, stated where a machine can check.
factory:EnvelopeShape a sh:NodeShape ;
    sh:targetClass factory:Envelope ;
    sh:property [ sh:path [ sh:inversePath earl:subject ] ;
        sh:qualifiedValueShape [ sh:class factory:GateResult ] ;
        sh:qualifiedMaxCount 0 ] .

# The design record (CONTEXT.md §11). These constrain a document rather than a
# ledger row, which is the one thing §4.6 says a shape is for: an axiom the
# thing being described cannot state about itself. Markdown cannot say "every
# principle was contributed by exactly one appendix".
factory:PrincipleShape a sh:NodeShape ;
    sh:targetClass factory:Principle ;
    sh:property [ sh:path factory:principleNumber ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path factory:claim ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 12 ] ;
    sh:property [ sh:path factory:contributedBy ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class factory:RevisionAppendix ] .

# Contiguity of the sequence is *not* here: SHACL constrains a focus node, not a
# set, so "1..N with no gaps" has no shape form. `tests/ontology/test_design_
# record.py` holds it, and says that this is why.
factory:RevisionAppendixShape a sh:NodeShape ;
    sh:targetClass factory:RevisionAppendix ;
    sh:property [ sh:path factory:appendixLetter ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:pattern "^[A-Z]$" ] ;
    sh:property [ sh:path factory:coversRevision ; sh:minCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 1 ] .
