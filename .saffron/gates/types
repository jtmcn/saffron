#!/bin/sh
# `typecheck.py`, not `types.py`: python puts the script's own directory on
# sys.path[0], so a `types.py` beside it shadows the stdlib module every
# import of `json`/`re`/`functools` reaches through. Measured — it crashed
# under one interpreter and survived under another, writing nothing to stdout.
exec python3 "$(dirname "$0")/typecheck.py"
