<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.saffron.batch</string>

  <!-- Absolute paths throughout: launchd runs with almost no environment and
       no shell, so `uv`, the repo and the token file are all named in full.
       Edit the three marked YOURNAME paths before loading this. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <!-- The token is read from the secrets file at fire time and reaches
         exactly this process, which is the same rule CLAUDE.md states for
         running a cell by hand: never direnv, never `.env`, never exported
         into a shell where a Claude Code session could inherit it. -->
    <string>source /Users/YOURNAME/.secrets &amp;&amp; exec /opt/homebrew/bin/uv run saffron batch --repo /Users/YOURNAME/Code/saffron --budget 50 --until 06:30</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOURNAME/Code/saffron</string>

  <!-- 22:00 nightly. `launchd`, not cron: it runs a missed job after a wake
       instead of silently skipping a sleeping Mac (DESIGN.md §4.4). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>22</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- The batch's own record is the ledger and the batch tree; these two files
       only catch what dies before either exists — a bad path here, a missing
       `uv`, a token file that is not readable. -->
  <key>StandardOutPath</key>
  <string>/Users/YOURNAME/.saffron/batch.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOURNAME/.saffron/batch.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
