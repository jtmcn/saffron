# Semantic search needs an OpenAI-compatible embeddings endpoint (see .env.example).
# .env is gitignored; uncomment to load it automatically on cd.
dotenv_if_exists .env

# Machine-local secrets are deliberately NOT loaded here: direnv would export
# CLAUDE_CODE_OAUTH_TOKEN into every shell in this directory, and into any Claude
# Code session started in one. A cell gets it per-invocation (CLAUDE.md).
