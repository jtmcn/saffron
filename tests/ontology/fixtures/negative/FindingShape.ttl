@prefix factory: <urn:software-factory:ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix : <urn:software-factory:data:> .

# One finding, two lenses. Lenses are disjoint by construction (§5.5).
:f a factory:Finding ; factory:severity factory:blocker ;
   earl:assertedBy :lens-a, :lens-b ; earl:subject :d .
:d a factory:Diff, earl:TestSubject .
:lens-a a factory:CriticLens . :lens-b a factory:CriticLens .
factory:blocker a factory:Severity .
