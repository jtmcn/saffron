@prefix factory: <urn:software-factory:ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix : <urn:software-factory:data:> .

# Core and contract at once — the core/repo boundary collapsed. Everything else
# about the node is valid, so only the xone can be what fires.
factory:scope a factory:Gate, factory:CoreGate, factory:ContractGate ;
   factory:role factory:lint ; factory:blockingAt factory:alwaysBlocking .
factory:lint a factory:GateRole .
factory:alwaysBlocking a factory:BlockingLevel .
