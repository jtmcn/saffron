@prefix saffron: <https://saffron.dev/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix : <https://saffron.dev/data/> .

# Core and contract at once — the core/repo boundary collapsed.
:g a saffron:Gate, saffron:CoreGate, saffron:ContractGate ;
   saffron:blockingAt saffron:alwaysBlocking .
saffron:alwaysBlocking a saffron:BlockingLevel .
