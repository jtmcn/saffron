@prefix factory: <urn:software-factory:ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix : <urn:software-factory:data:> .

# declaresGate pointing at something that is not a gate.
:p a factory:Policy ; factory:declaresGate :not-a-gate .
# A blocking level, so only the class check fires and not DeclaredGateShape.
:not-a-gate factory:blockingAt factory:advisory .
factory:advisory a factory:BlockingLevel .
