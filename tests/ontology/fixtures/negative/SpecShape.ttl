@prefix factory: <urn:software-factory:ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix : <urn:software-factory:data:> .

# "chore" is not one of the three spec types.
:s a factory:Spec ; factory:specType :chore ; factory:hasCriterion :ac .
:ac a factory:AcceptanceCriterion .
