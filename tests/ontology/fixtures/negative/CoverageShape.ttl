@prefix saffron: <https://saffron.dev/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix : <https://saffron.dev/data/> .

# A policy declaring its coverage executable blocking. It is advisory at every tier.
:g a saffron:Gate, saffron:ContractGate ; saffron:role saffron:coverage ;
   saffron:blockingAt saffron:alwaysBlocking .
saffron:coverage a saffron:GateRole . saffron:alwaysBlocking a saffron:BlockingLevel .
