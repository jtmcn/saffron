@prefix saffron: <https://saffron.dev/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix : <https://saffron.dev/data/> .

# A gate result asserted semi-automatically. Gates are deterministic (§5.4).
:gr a saffron:GateResult ; earl:assertedBy :g ; earl:mode earl:semiAuto .
:g a saffron:Gate .
