@prefix factory: <urn:software-factory:ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix : <urn:software-factory:data:> .

# A gate result asserted semi-automatically. Gates are deterministic (§5.4).
:gr a factory:GateResult ; earl:assertedBy :g ; earl:mode earl:semiAuto ; earl:subject :d .
:d a factory:Diff, earl:TestSubject .
:g a factory:Gate, factory:ContractGate ; factory:role factory:lint ;
   factory:blockingAt factory:alwaysBlocking .
factory:lint a factory:GateRole .
factory:alwaysBlocking a factory:BlockingLevel .
