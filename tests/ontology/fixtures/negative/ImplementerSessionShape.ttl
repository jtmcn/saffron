@prefix saffron: <https://saffron.dev/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix : <https://saffron.dev/data/> .

# An implementer's diff with no plan behind it. The plan checkpoint opens
# IMPLEMENT, so no diff is written before a plan is validated.
:operator a saffron:Operator .
:impl a saffron:ImplementerSession ; prov:actedOnBehalfOf :operator .
:ph a saffron:Phase .
:d a saffron:Diff .
:at a saffron:Attempt ; saffron:withinPhase :ph ; saffron:n 1 ; prov:generated :d ;
    prov:qualifiedAssociation [ prov:agent :impl ] .
