@prefix factory: <urn:software-factory:ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix : <urn:software-factory:data:> .

# A delegate credited with a task's attempt. The run record holds what a cell did
# under enforcement; a delegate's work is never part of it.
:operator a factory:Operator .
:session a factory:Delegate ; prov:actedOnBehalfOf :operator .
:ph a factory:Phase .
:at a factory:Attempt ; factory:withinPhase :ph ; factory:n 1 ;
    prov:qualifiedAssociation [ prov:agent :session ] .
