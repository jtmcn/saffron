@prefix saffron: <https://saffron.dev/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix : <https://saffron.dev/data/> .

# A delegate credited with a task's attempt. The run record holds what a cell did
# under enforcement; a delegate's work is never part of it.
:operator a saffron:Operator .
:session a saffron:Delegate ; prov:actedOnBehalfOf :operator .
:ph a saffron:Phase .
:at a saffron:Attempt ; saffron:withinPhase :ph ; saffron:n 1 ;
    prov:qualifiedAssociation [ prov:agent :session ] .
