@prefix factory: <urn:software-factory:ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix : <urn:software-factory:data:> .

# A contract gate implementing no declared role.
:g a factory:Gate, factory:ContractGate ; factory:blockingAt factory:alwaysBlocking .
factory:alwaysBlocking a factory:BlockingLevel .
