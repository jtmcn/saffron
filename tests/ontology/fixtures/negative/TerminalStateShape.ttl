@prefix factory: <urn:software-factory:ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix : <urn:software-factory:data:> .

# MERGED is what the operator's decision produces, not a state that reaches them.
factory:MERGED a factory:TerminalState, factory:EndState .
