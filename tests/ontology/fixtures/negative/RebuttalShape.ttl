@prefix saffron: <https://saffron.dev/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix : <https://saffron.dev/data/> .

# The implementer argued and no lens ever verdicted it (§5.6).
:rb a saffron:Rebuttal ; prov:used :f ;
   prov:qualifiedAssociation [ prov:agent :impl ; prov:hadRole saffron:disputes ] .
:f a saffron:Finding . :impl a saffron:ImplementerSession .
saffron:disputes a saffron:Role .
