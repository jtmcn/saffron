# One night, hand-authored. Three tasks: a bug that was scope-reviewed, rebutted
# and merged; a refactor that exhausted; a feature the operator rejected.
@prefix factory: <urn:software-factory:ns#> .
@prefix :        <urn:software-factory:data:> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix earl:    <http://www.w3.org/ns/earl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

:batch-1 a factory:Batch ; factory:budgetUsd 50.00 .
:run-1 a factory:Run ; prov:wasInformedBy :batch-1 ; prov:used :policy-1 ;
    factory:baseSha "3f9c1a2" .

## Agents
:operator a factory:Operator .
:lens-correctness a factory:CriticLens .
:lens-contract    a factory:CriticLens .
:lens-blast       a factory:CriticLens .
:impl-t1 a factory:ImplementerSession ; prov:actedOnBehalfOf :operator .
:impl-t3 a factory:ImplementerSession ; prov:actedOnBehalfOf :operator .
:delegate-1 a factory:Delegate ; prov:actedOnBehalfOf :operator .

## Gates, and the policy that declares them. Core gates are the vocabulary's own
## individuals — there is one implementation of each. Contract gates are this
## repo's executables for a core-supplied role. `no-network` is declared and
## never runs in this batch: the case Q3's second half exists to find.
:g-lint  a factory:ContractGate ; factory:role factory:lint ;
    factory:blockingAt factory:alwaysBlocking .
:g-types a factory:ContractGate ; factory:role factory:types ;
    factory:blockingAt factory:alwaysBlocking .
:g-tests a factory:ContractGate ; factory:role factory:tests ;
    factory:blockingAt factory:alwaysBlocking .
:g-nonet a factory:ContractGate ; factory:role factory:no-network ;
    factory:blockingAt factory:alwaysBlocking .
:g-cov   a factory:ContractGate ; factory:role factory:coverage ;
    factory:blockingAt factory:advisory .
:policy-1 a factory:Policy ;
    factory:declaresGate factory:scope, factory:size, factory:census,
                         :g-lint, :g-types, :g-tests, :g-nonet, :g-cov .

## ── t1: bug, elevated, SCOPE_REVIEW ratified, one blocker rebutted, merged ──
:spec-t1 a factory:Spec ; factory:specType factory:bug ;
    factory:hasCriterion :ac-t1-1, :ac-t1-2 .
:ac-t1-1 a factory:AcceptanceCriterion .
:ac-t1-2 a factory:AcceptanceCriterion .
:env-t1 a factory:Envelope .
:scope-t1 a factory:ScopeProposal ; prov:wasDerivedFrom :spec-t1 .
:touches-t1 a factory:TouchesSet ;
    prov:wasDerivedFrom :scope-t1 ; factory:ratifiedBy :operator .
:plan-t1 a factory:Plan ; prov:wasDerivedFrom :spec-t1, :touches-t1 .

:task-t1 a factory:Task ; prov:wasInformedBy :run-1 ; prov:used :spec-t1 ;
    factory:riskTier factory:elevated ; factory:endedInState factory:MERGED .
:ph-t1-diagnose a factory:Phase ; prov:wasInformedBy :task-t1 .
:ph-t1-implement a factory:Phase ; prov:wasInformedBy :task-t1 .
:at-t1-d1 a factory:Attempt ; factory:withinPhase :ph-t1-diagnose ; factory:n 1 ;
    factory:costUsdEst 0.40 ; prov:generated :scope-t1 .
# The plan checkpoint opens attempt 1, so the attempt that writes the plan works to it.
:at-t1-i1 a factory:Attempt ; factory:withinPhase :ph-t1-implement ; factory:n 1 ;
    factory:costUsdEst 3.20 ; prov:generated :plan-t1, :diff-t1-1 ;
    prov:qualifiedAssociation [ a prov:Association ; prov:agent :impl-t1 ; prov:hadPlan :plan-t1 ] .
:at-t1-i2 a factory:Attempt ; factory:withinPhase :ph-t1-implement ; factory:n 2 ;
    factory:costUsdEst 1.10 ; prov:generated :diff-t1-2 ;
    prov:qualifiedAssociation [ a prov:Association ; prov:agent :impl-t1 ; prov:hadPlan :plan-t1 ] .
:diff-t1-1 a factory:Diff ; prov:wasDerivedFrom :plan-t1 .
:diff-t1-2 a factory:Diff ; prov:wasRevisionOf :diff-t1-1 .

# Attempt 1's suite: `lint` alone red. Attempt 2's: all green.
:suite-t1-1 a factory:GateSuite ; prov:wasInformedBy :at-t1-i1 ; prov:used :diff-t1-1 .
:suite-t1-2 a factory:GateSuite ; prov:wasInformedBy :at-t1-i2 ; prov:used :diff-t1-2 .
:gr-t1-1-lint a factory:GateResult ; prov:wasGeneratedBy :suite-t1-1 ;
    earl:assertedBy :g-lint ; earl:subject :diff-t1-1 ; earl:mode earl:automatic ;
    earl:result [ earl:outcome earl:failed ] .
:gr-t1-1-scope a factory:GateResult ; prov:wasGeneratedBy :suite-t1-1 ;
    earl:assertedBy factory:scope ; earl:subject :diff-t1-1 ; earl:mode earl:automatic ;
    earl:result [ earl:outcome earl:passed ] .
:gr-t1-1-size a factory:GateResult ; prov:wasGeneratedBy :suite-t1-1 ;
    earl:assertedBy factory:size ; earl:subject :diff-t1-1 ; earl:mode earl:automatic ;
    earl:result [ earl:outcome earl:passed ] .
:gr-t1-2-lint a factory:GateResult ; prov:wasGeneratedBy :suite-t1-2 ;
    earl:assertedBy :g-lint ; earl:subject :diff-t1-2 ; earl:mode earl:automatic ;
    earl:result [ earl:outcome earl:passed ] .
:gr-t1-2-census a factory:GateResult ; prov:wasGeneratedBy :suite-t1-2 ;
    earl:assertedBy factory:census ; earl:subject :diff-t1-2 ; earl:mode earl:automatic ;
    earl:result [ earl:outcome earl:passed ] .
# `coverage` is advisory; it is red on a merged task and stopped nothing.
:gr-t1-2-cov a factory:GateResult ; prov:wasGeneratedBy :suite-t1-2 ;
    earl:assertedBy :g-cov ; earl:subject :diff-t1-2 ; earl:mode earl:automatic ;
    earl:result [ earl:outcome earl:failed ] .

:finding-t1-1 a factory:Finding ; factory:severity factory:blocker ;
    earl:assertedBy :lens-correctness ; earl:subject :diff-t1-1 ;
    earl:test :ac-t1-1 ; earl:mode earl:semiAuto ;
    earl:result [ earl:outcome earl:failed ] .
:finding-t1-2 a factory:Finding ; factory:severity factory:concern ;
    earl:assertedBy :lens-contract ; earl:subject :diff-t1-1 ; earl:mode earl:semiAuto ;
    earl:result [ earl:outcome earl:cantTell ] .

# The disagreement of §5.6 as three qualified associations, not three strings:
# the implementer disputed, the lens confirmed anyway, the operator sided with
# the implementer. A string column cannot say who held which position.
:rebut-t1-1 a factory:Rebuttal ; prov:used :finding-t1-1 ; prov:generated :diff-t1-2 ;
    prov:qualifiedAssociation
      [ a prov:Association ; prov:agent :impl-t1 ; prov:hadRole factory:disputes ] ,
      [ a prov:Association ; prov:agent :lens-correctness ; prov:hadRole factory:confirms ] ,
      [ a prov:Association ; prov:agent :operator ; prov:hadRole factory:disagrees ] .

:pr-t1 a factory:PullRequest ; prov:wasDerivedFrom :diff-t1-2 .

## ── t2: refactor, standard, EXHAUSTED — `types` red twice, alone the first time ──
:spec-t2 a factory:Spec ; factory:specType factory:refactor ; factory:hasCriterion :ac-t2-1 .
:ac-t2-1 a factory:AcceptanceCriterion .
:task-t2 a factory:Task ; prov:wasInformedBy :run-1 ; prov:used :spec-t2 ;
    factory:riskTier factory:standard ; factory:endedInState factory:EXHAUSTED .
:ph-t2-implement a factory:Phase ; prov:wasInformedBy :task-t2 .
:at-t2-1 a factory:Attempt ; factory:withinPhase :ph-t2-implement ; factory:n 1 ;
    factory:costUsdEst 2.80 ; prov:generated :diff-t2-1 .
:at-t2-2 a factory:Attempt ; factory:withinPhase :ph-t2-implement ; factory:n 2 ;
    factory:costUsdEst 2.10 ; prov:generated :diff-t2-2 .
:diff-t2-1 a factory:Diff . :diff-t2-2 a factory:Diff ; prov:wasRevisionOf :diff-t2-1 .
:suite-t2-1 a factory:GateSuite ; prov:wasInformedBy :at-t2-1 ; prov:used :diff-t2-1 .
:suite-t2-2 a factory:GateSuite ; prov:wasInformedBy :at-t2-2 ; prov:used :diff-t2-2 .
:gr-t2-1-types a factory:GateResult ; prov:wasGeneratedBy :suite-t2-1 ;
    earl:assertedBy :g-types ; earl:subject :diff-t2-1 ; earl:mode earl:automatic ;
    earl:result [ earl:outcome earl:failed ] .
:gr-t2-1-lint a factory:GateResult ; prov:wasGeneratedBy :suite-t2-1 ;
    earl:assertedBy :g-lint ; earl:subject :diff-t2-1 ; earl:mode earl:automatic ;
    earl:result [ earl:outcome earl:passed ] .
:gr-t2-2-types a factory:GateResult ; prov:wasGeneratedBy :suite-t2-2 ;
    earl:assertedBy :g-types ; earl:subject :diff-t2-2 ; earl:mode earl:automatic ;
    earl:result [ earl:outcome earl:failed ] .
:gr-t2-2-tests a factory:GateResult ; prov:wasGeneratedBy :suite-t2-2 ;
    earl:assertedBy :g-tests ; earl:subject :diff-t2-2 ; earl:mode earl:automatic ;
    earl:result [ earl:outcome earl:failed ] .

## ── t3: feature, standard, merged then rejected by the operator ──
:spec-t3 a factory:Spec ; factory:specType factory:feature ;
    factory:hasCriterion :ac-t3-1, :ac-t3-2 .
:ac-t3-1 a factory:AcceptanceCriterion .
:ac-t3-2 a factory:AcceptanceCriterion .
:task-t3 a factory:Task ; prov:wasInformedBy :run-1 ; prov:used :spec-t3 ;
    factory:riskTier factory:standard ; factory:endedInState factory:REJECTED .
:ph-t3-implement a factory:Phase ; prov:wasInformedBy :task-t3 .
:at-t3-1 a factory:Attempt ; factory:withinPhase :ph-t3-implement ; factory:n 1 ;
    factory:costUsdEst 4.60 ; prov:generated :diff-t3-1 .
:diff-t3-1 a factory:Diff .
:suite-t3-1 a factory:GateSuite ; prov:wasInformedBy :at-t3-1 ; prov:used :diff-t3-1 .
:gr-t3-1-tests a factory:GateResult ; prov:wasGeneratedBy :suite-t3-1 ;
    earl:assertedBy :g-tests ; earl:subject :diff-t3-1 ; earl:test :ac-t3-2 ;
    earl:mode earl:automatic ; earl:result [ earl:outcome earl:passed ] .
:finding-t3-1 a factory:Finding ; factory:severity factory:blocker ;
    earl:assertedBy :lens-blast ; earl:subject :diff-t3-1 ; earl:mode earl:semiAuto ;
    earl:result [ earl:outcome earl:failed ] .
:rebut-t3-1 a factory:Rebuttal ; prov:used :finding-t3-1 ;
    prov:qualifiedAssociation
      [ a prov:Association ; prov:agent :impl-t3 ; prov:hadRole factory:concedes ] ,
      [ a prov:Association ; prov:agent :lens-blast ; prov:hadRole factory:withdraws ] ,
      [ a prov:Association ; prov:agent :operator ; prov:hadRole factory:agrees ] .
:pr-t3 a factory:PullRequest ; prov:wasDerivedFrom :diff-t3-1 .

# All four gate statuses of CONTEXT.md §4 occur, because EARL's outcome values are
# them: `skip` is inapplicable — the repo declares no such gate, nothing is wrong —
# and `error` is cantTell, the gate itself breaking. Neither is `earl:failed`, which
# is the distinction §4 calls the most important one in the section.
:gr-t3-1-cov a factory:GateResult ; prov:wasGeneratedBy :suite-t3-1 ;
    earl:assertedBy :g-cov ; earl:subject :diff-t3-1 ; earl:mode earl:automatic ;
    earl:result [ earl:outcome earl:inapplicable ] .
:gr-t3-1-census a factory:GateResult ; prov:wasGeneratedBy :suite-t3-1 ;
    earl:assertedBy factory:census ; earl:subject :diff-t3-1 ; earl:mode earl:automatic ;
    earl:result [ earl:outcome earl:cantTell ] .

# The operator's rejection, as an assertion in the same shape as a mypy failure:
# ac-t3-1 failed, and nothing automatic had asserted on it. That gap is the
# bucket-triage evidence Q1 exists to pull up.
:adj-t3-1 a earl:Assertion ; earl:assertedBy :operator ; earl:subject :pr-t3 ;
    earl:test :ac-t3-1 ; earl:mode earl:manual ;
    earl:result [ earl:outcome earl:failed ] .

## ── t4: feature, standard, merged — the second cost group for Q5 ──
:spec-t4 a factory:Spec ; factory:specType factory:feature ; factory:hasCriterion :ac-t4-1 .
:ac-t4-1 a factory:AcceptanceCriterion .
:task-t4 a factory:Task ; prov:wasInformedBy :run-1 ; prov:used :spec-t4 ;
    factory:riskTier factory:standard ; factory:endedInState factory:MERGED .
:ph-t4-implement a factory:Phase ; prov:wasInformedBy :task-t4 .
:at-t4-1 a factory:Attempt ; factory:withinPhase :ph-t4-implement ; factory:n 1 ;
    factory:costUsdEst 5.50 ; prov:generated :diff-t4-1 .
:diff-t4-1 a factory:Diff .
:pr-t4 a factory:PullRequest ; prov:wasDerivedFrom :diff-t4-1 .
