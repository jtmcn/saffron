#!/usr/bin/env python3
"""One tool's output -> the gate contract.

Copied to `.saffron/gates/<name>`. Fill the three FILL constants for the tool.
"""

import json
import os
import re
import subprocess
import sys

GATE = os.path.basename(sys.argv[0])
# FILL: the tool's own version command. `tool` must come from running it.
VERSION = ["FILL-tool", "--version"]
# FILL: the check itself, reporting and never fixing.
COMMAND = ["FILL-tool", "check", "."]
# FILL: one failure per matching output line. `code` holds no line number.
FAILURE = re.compile(
    r"^(?P<file>[^:\s]+):(?P<line>\d+):\d+: (?P<code>\S+) (?P<message>.*)$"
)


def failure(m):
    # FILL: one contract failure from one FAILURE match. `line` may be None.
    return {
        "file": m["file"],
        "line": int(m["line"]),
        "code": m["code"],
        "message": m["message"],
    }


def emit(status, summary, tool=None, failures=()):
    result = {"gate": GATE, "status": status, "tool": tool, "summary": summary}
    print(json.dumps({**result, "failures": list(failures)}))


def main():
    try:
        version = subprocess.run(VERSION, capture_output=True, text=True, check=True)
    except (OSError, subprocess.CalledProcessError) as exc:
        emit("error", f"{VERSION[0]} could not run: {exc}")
        return 0
    tool = (version.stdout or version.stderr).strip().splitlines()[0]

    done = subprocess.run(COMMAND, capture_output=True, text=True)
    failures = [
        failure(m)
        for m in map(FAILURE.match, (done.stdout + done.stderr).splitlines())
        if m
    ]
    if done.returncode == 0:
        emit("pass", "clean", tool)
        return 0
    if not failures:
        # Nonzero and nothing parsed: the output shape changed. Never a pass.
        emit("error", f"exited {done.returncode}, parsed no failures", tool)
        return 0
    emit("fail", f"{len(failures)} failures", tool, failures)
    return 1


if __name__ == "__main__":
    sys.exit(main())
